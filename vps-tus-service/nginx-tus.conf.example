# Add this location block to the existing Nginx server {} block that already
# serves /srv/clickbuz-media as static files. It routes tus protocol requests
# (POST/PATCH/HEAD/DELETE under /files/) to the local Node tus service, while
# leaving GET requests for actual media files (e.g. /movies/foo.mp4) served
# directly by Nginx's existing static config, unchanged.

location /files {
    # tus PATCH requests carry large chunks — Nginx's ~1MB default would
    # reject them. 0 = unlimited (the tus service enforces its own real
    # per-field size ceilings independently).
    client_max_body_size 0;

    proxy_pass http://127.0.0.1:1080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Large uploads can run for hours — don't let Nginx time out an
    # otherwise-healthy, slow-but-progressing connection.
    proxy_read_timeout 6h;
    proxy_send_timeout 6h;

    # Required so tus-js-client (running cross-origin from the frontend) can
    # read these response headers, including the custom Upload-Info header
    # this service returns with the final media URL on completion.
    add_header Access-Control-Expose-Headers "Location, Upload-Offset, Upload-Length, Tus-Version, Tus-Resumable, Tus-Max-Size, Tus-Extension, Upload-Metadata, Upload-Info" always;
}
