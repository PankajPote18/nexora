[Unit]
Description=ClickBuz tus resumable upload service
After=network.target

[Service]
Type=simple
User=clickbuz-tus
WorkingDirectory=/opt/clickbuz-tus-service
ExecStart=/usr/bin/node /opt/clickbuz-tus-service/server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/opt/clickbuz-tus-service/.env

[Install]
WantedBy=multi-user.target
