PORT=5000
NODE_ENV=development
DB_HOST=hayabusa.proxy.rlwy.net
DB_USER=root
DB_PASSWORD=cDOwCnSnsRZFIcGjokPadpGGLBhDRdKm
DB_NAME=railway
DB_PORT=56455
DATABASE_URL=mysql://root:cDOwCnSnsRZFIcGjokPadpGGLBhDRdKm@hayabusa.proxy.rlwy.net:56455/railway

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# PayU UPI Intent S2S — fill these in from your PayU merchant dashboard.
# PAYU_ENV switches both the endpoint used and which key/salt pair applies: 'test' or 'production'.
PAYU_ENV=test
PAYU_MERCHANT_KEY=sSKM0Z
PAYU_SALT=XQB4FslmTBKUBqXpev2fTwJJPMa7YBB8
# Public base URL of THIS backend, used to build the surl/furl PayU posts back to (no trailing slash).
BACKEND_URL=http://localhost:5000
# Base URL of the frontend, used only to redirect the browser back after a surl/furl hit (no trailing slash).
FRONTEND_URL=http://localhost:5173

# VPS media server (Ubuntu, Nginx serving /srv/clickbuz-media) — small files
# (banner/poster/thumbnail/subtitle) are pushed here over SFTP using SSH KEY
# auth only (no password auth supported).
SFTP_HOST=160.187.80.144
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=./keys/clickbuz_sftp_key
SFTP_PASSPHRASE=
SFTP_REMOTE_BASE=/srv/clickbuz-media
# Public base URL used to build every generated media URL (read/serving path).
# Swapping this to https://cdn.clickbuz.com later requires no code changes.
MEDIA_BASE_URL=http://160.187.80.144

# Large files (movie/trailer) upload directly from the browser to the VPS via
# the tus resumable protocol — this backend only issues short-lived upload
# authorization tokens, it never receives or relays the file bytes.
# TUS_UPLOAD_ENDPOINT is the VPS's tus WRITE endpoint — deliberately separate
# from MEDIA_BASE_URL (the READ path), since uploads still go to the VPS
# origin even after MEDIA_BASE_URL later points at Bunny CDN for reads.
TUS_UPLOAD_ENDPOINT=http://160.187.80.144/files/
# Shared secret the VPS tus service uses to authenticate its completion webhook back to this backend.
TUS_WEBHOOK_SECRET=b422a158d0ea0f2078e9ed32162b5346439f61397ed45517b8a5bb00846fbf47
# How long an upload-authorization token stays valid — long enough to survive
# a multi-hour large upload with interruptions, short enough to bound cleanup.
TUS_UPLOAD_TOKEN_EXPIRY=24h

# Per-field upload size caps in MB — enforced both here and (independently, as
# defense-in-depth) on the VPS. Change these without touching any code.
MAX_UPLOAD_MB_BANNER=10
MAX_UPLOAD_MB_POSTER=10
MAX_UPLOAD_MB_THUMBNAIL=10
MAX_UPLOAD_MB_SUBTITLE=5
MAX_UPLOAD_MB_MOVIE=20480
MAX_UPLOAD_MB_TRAILER=2048
