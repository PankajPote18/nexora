DB_NAME=railway
DB_PORT=3306
DATABASE_URL=mysql://clickbuz:Cbz%402026!MySQL%23VPS87@160.187.80.144:3306/railway

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# PayU UPI Intent S2S — fill these in from your PayU merchant dashboard.
# PAYU_ENV switches both the endpoint used and which key/salt pair applies: 'test' or 'production'.
PAYU_ENV=test
PAYU_MERCHANT_KEY=sSKM0Z
PAYU_SALT=XQB4FslmTBKUBqXpev2fTwJJPMa7YBB8
# Public base URL of THIS backend, used to build the surl/furl PayU posts back to (no trailing slash).
BACKEND_URL=https://nexora-backend1.onrender.com
# Base URL of the frontend, used only to redirect the browser back after a surl/furl hit (no trailing slash).
FRONTEND_URL=https://clickbuz.in

# Bunny Storage (Edge Storage) — every media type (banner/poster/thumbnail/
# subtitle/movie/trailer) streams here directly (browser -> Express -> Bunny
# Storage), never touching local disk. BUNNY_STORAGE_REGION is the storage
# zone's replication region code (e.g. "ny", "la", "sg", "syd") — leave blank
# for the default (Falkenstein) region.
BUNNY_STORAGE_ZONE=clickbuz-storage
BUNNY_STORAGE_REGION=sg
BUNNY_STORAGE_ACCESS_KEY=1897940e-38c1-4247-a398bc33459b-232a-44a0  
# Public CDN (Pull Zone) base URL connected to the storage zone, used to build
# every generated media URL (banner/poster/thumbnail/subtitle/movie/trailer).
# No trailing slash.
BUNNY_CDN_BASE_URL=https://clickbuz-media.b-cdn.net

# Per-field upload size caps in MB — enforced by upload.middleware.js as bytes
# stream in, before/while the file is relayed to Bunny Storage. Change these
# without touching any code.
MAX_UPLOAD_MB_BANNER=10
MAX_UPLOAD_MB_POSTER=10
MAX_UPLOAD_MB_THUMBNAIL=10
MAX_UPLOAD_MB_SUBTITLE=5
MAX_UPLOAD_MB_MOVIE=20480
MAX_UPLOAD_MB_TRAILER=2048
