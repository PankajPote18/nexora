# Names only — never real values in this file. Copy to backend/.env and fill in.

PORT=5000
NODE_ENV=development

# Self-hosted Ubuntu VPS MySQL — see CLAUDE.md §7/§11 (Railway is no longer used).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DATABASE_URL=
DB_SSL=

JWT_SECRET=
JWT_EXPIRES_IN=30d

PAYU_ENV=test
PAYU_MERCHANT_KEY=
PAYU_SALT=
BACKEND_URL=
FRONTEND_URL=

# ── Meta Conversions API (server-side CompleteRegistration mirror; see CLAUDE.md §24) ──
# Backend's own copy of the Pixel ID — separate from the frontend's
# VITE_META_PIXEL_ID (a Vite build-time var, not accessible to Node). Use the
# same Pixel ID as the frontend.
META_PIXEL_ID=
# Generate at Events Manager > [Your Pixel] > Settings > Conversions API >
# Generate Access Token.
META_CAPI_ACCESS_TOKEN=
# Only for Meta's Test Events tool in Events Manager — leave empty in production.
META_CAPI_TEST_EVENT_CODE=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_BASE_URL=

MAX_UPLOAD_MB_BANNER=10
MAX_UPLOAD_MB_POSTER=10
MAX_UPLOAD_MB_THUMBNAIL=10
MAX_UPLOAD_MB_SUBTITLE=5
MAX_UPLOAD_MB_MOVIE=20480
MAX_UPLOAD_MB_TRAILER=2048

# Reminder system (RabbitMQ + cron) — see backend/jobs|queues|workers|services
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_RECONNECT_DELAY_MS=5000
REMINDER_QUEUE_NAME=reminder_queue
REMINDER_CRON_SCHEDULE=* * * * *
REMINDER_DAYS_BEFORE=7
REMINDER_MAX_RETRIES=3
REMINDER_RETRY_DELAY_MS=3000

# Autopay billing system (RabbitMQ + cron, PayU UPI Autopay recurring debits)
# — see backend/jobs|queues|workers/autopayBilling.* and
# services/autopayBilling.service.js. Reuses RABBITMQ_URL/
# RABBITMQ_RECONNECT_DELAY_MS above — no separate connection needed.
AUTOPAY_BILLING_QUEUE_NAME=autopay_billing_queue
AUTOPAY_BILLING_CRON_SCHEDULE=* * * * *
AUTOPAY_BILLING_GRACE_MINUTES=0
AUTOPAY_MAX_RETRIES=3
AUTOPAY_RETRY_DELAY_MS=3000
AUTOPAY_MAX_CONSECUTIVE_FAILURES=3

# ── Website Analytics System (see CLAUDE.md §23) ────────────────────────────
# Salt used to one-way-hash visitor IP addresses before anything ever touches
# the database — raw IPs are never stored. Set this to a long random string
# in production; changing it later just means IP-based dedup/rate-limiting
# resets (no visitor data is lost).
ANALYTICS_IP_HASH_SALT=

# IP Geolocation — MaxMind GeoLite2 City, read from a local .mmdb database
# file for fast/offline lookups (see backend/scripts/downloadGeoDb.js,
# `npm run geo:update` from backend/). Get a free license key from your
# MaxMind account: https://www.maxmind.com/en/accounts/current/license-key
# Leave MAXMIND_LICENSE_KEY empty to disable geolocation enrichment entirely
# (country/region/city/lat/long will just stay null; nothing else breaks).
MAXMIND_LICENSE_KEY=
# Only needed if you want the MaxMind web-service fallback (used when no
# local .mmdb file is present) instead of/alongside the local database.
MAXMIND_ACCOUNT_ID=
MAXMIND_EDITION_ID=GeoLite2-City
MAXMIND_DB_PATH=data/GeoLite2-City.mmdb

# In-process tracking write buffer (backend/services/analytics/eventBuffer.service.js)
ANALYTICS_FLUSH_INTERVAL_MS=3000
ANALYTICS_MAX_BUFFER_SIZE=500

# Per-IP tracking requests allowed per minute before the /api/analytics/collect
# endpoint silently drops further hits (abuse/bot protection).
ANALYTICS_RATE_LIMIT_PER_MINUTE=300

# Nightly job that pre-aggregates analytics_daily_summary for the dashboard's
# trend charts (backend/jobs/analyticsRollup.cron.js). Default: 00:10 daily.
ANALYTICS_ROLLUP_CRON_SCHEDULE=10 0 * * *
